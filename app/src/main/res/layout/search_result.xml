<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_small"
    android:clickable="true" android:focusable="true" android:minHeight="@dimen/action_touch_target"
    app:cardCornerRadius="@dimen/panel_corner_radius" app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="?attr/colorOutlineVariant">
    <LinearLayout android:id="@+id/result_line" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:paddingStart="@dimen/space_medium" android:paddingEnd="@dimen/space_small"
        android:paddingVertical="@dimen/space_small">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/result_word" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView android:id="@+id/result_translation" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                android:textColor="@color/secondary_text" android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
