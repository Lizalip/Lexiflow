<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:paddingVertical="@dimen/space_large"
    android:paddingHorizontal="@dimen/content_horizontal_padding"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <TextView android:id="@+id/title" android:textAppearance="@style/PageHeading"
        android:accessibilityHeading="true" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView android:id="@+id/research_banner" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small" android:text="@string/research_corpus_notice" />

    <TextView android:id="@+id/pair" android:text="@string/pair" android:textAppearance="?attr/textAppearanceTitleMedium"
        android:layout_marginTop="@dimen/space_small" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/query_box" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_large" android:hint="@string/query_hint"
        app:startIconDrawable="@drawable/ic_search" app:endIconMode="clear_text"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/query" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLength="256" android:maxLines="1" android:inputType="text" android:imeOptions="actionDone"
            android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/saved_query_box" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_large" android:hint="@string/saved_query_hint"
        app:startIconDrawable="@drawable/ic_search" app:endIconMode="clear_text"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/saved_query" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLength="256" android:maxLines="1" android:inputType="text" android:imeOptions="actionDone"
            android:importantForAutofill="no" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/direction" android:layout_width="wrap_content" android:layout_height="wrap_content"
        style="@style/Widget.Material3.Button.TextButton" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_large"
        app:cardCornerRadius="@dimen/panel_corner_radius" app:cardBackgroundColor="@color/mint" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/space_large">
            <View android:layout_width="@dimen/panel_accent_width"
                android:layout_height="@dimen/panel_accent_height" android:background="@color/coral"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/panel_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:layout_marginTop="@dimen/space_medium" android:textAppearance="@style/PanelHeading" />
            <TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small" android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/secondary_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium" style="@style/Widget.Material3.Button.TonalButton" />

    <LinearLayout android:id="@+id/results" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
