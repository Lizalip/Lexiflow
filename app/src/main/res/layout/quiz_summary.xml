<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:paddingVertical="@dimen/space_medium">
    <androidx.appcompat.widget.AppCompatImageView android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_check" app:tint="@color/quiz_correct"
        android:importantForAccessibility="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small" android:gravity="center"
        android:accessibilityHeading="true" android:textAppearance="@style/PanelHeading"
        android:text="@string/review_session_finished" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_large" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/summary_tasks" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textAppearance="@style/PageHeading" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/secondary_text" android:gravity="center"
                android:text="@string/quiz_completed_tasks" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/summary_words" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textAppearance="@style/PageHeading" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/secondary_text" android:gravity="center"
                android:text="@string/quiz_unique_words" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
